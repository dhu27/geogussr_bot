# Copy to .env (gitignored) and fill in your own values. NEVER put real tokens in this file:
# it is committed to git.
#
# Mapillary client token: https://www.mapillary.com/dashboard/developers
MAPILLARY_TOKEN=
# Hugging Face token (write access) for scripts/data_hub.py: https://huggingface.co/settings/tokens
# Optional if you ran `hf auth login` instead.
HF_TOKEN=
# Optional: where datasets live. Default: ./datasets
# GEO_DATA_ROOT=
